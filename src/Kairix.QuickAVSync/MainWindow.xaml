<Window x:Class="Kairix.QuickAVSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kairix.QuickAVSync.Controls"
        Title="Kairix Quick A/V Sync" Width="1280" Height="820" MinWidth="960" MinHeight="650"
        Background="#0B1118" Foreground="#E8EEF5" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#121C27"/><SolidColorBrush x:Key="Panel2" Color="#182431"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#E8EEF5"/><Setter Property="Background" Value="#243445"/><Setter Property="BorderBrush" Value="#344A60"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#30465B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ToggleButton"><Setter Property="Foreground" Value="#AAB8C7"/><Setter Property="Background" Value="#222F3D"/><Setter Property="BorderBrush" Value="#344A60"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,6,7"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#126B61"/><Setter Property="Foreground" Value="White"/><Setter Property="Content" Value="ON"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#202D3A"/><Setter Property="Foreground" Value="#101010"/><Setter Property="Padding" Value="6"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1720"/><Setter Property="Foreground" Value="#E8EEF5"/><Setter Property="BorderBrush" Value="#344A60"/><Setter Property="Padding" Value="7"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#8FA2B5"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,6,0,5"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/></Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="250"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,10">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="KAIRIX" FontSize="11" FontWeight="Bold" Foreground="#5BD1BF"/><TextBlock Text="Quick A/V Sync" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="VIDEO DEVICE" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Margin="0,0,0,8"/>
        <WrapPanel><Button Content="Refresh Devices" Command="{Binding RefreshCommand}"/><Button Content="Reconnect" Command="{Binding ReconnectCommand}"/></WrapPanel>
        <TextBlock Text="DETECTION" Style="{StaticResource Label}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"><TextBlock Text="AUTO DETECT" FontSize="9" Foreground="#8FA2B5"/><ToggleButton Content="OFF" IsChecked="{Binding AutoDetect}"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="AUTO SPIKE" FontSize="9" Foreground="#8FA2B5"/><ToggleButton Content="OFF" IsChecked="{Binding AutoSpike}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="AUTO VISUAL" FontSize="9" Foreground="#8FA2B5"/><ToggleButton Content="OFF" IsChecked="{Binding AutoVisual}"/></StackPanel>
        </Grid>
        <Button Content="HOLD AUTO DETECT (H)" PreviewMouseLeftButtonDown="Hold_Down" PreviewMouseLeftButtonUp="Hold_Up" Background="#6B4B19" Margin="0,3,0,9"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ROLLING BUFFER (s)" Style="{StaticResource Label}"/><TextBox Text="{Binding RollingBufferSeconds, UpdateSourceTrigger=LostFocus}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="WORK WINDOW (±ms)" Style="{StaticResource Label}"/><TextBox Text="{Binding WorkWindowMilliseconds, UpdateSourceTrigger=LostFocus}"/></StackPanel></Grid>
        <TextBlock Text="RAM" Style="{StaticResource Label}"/><ProgressBar Value="{Binding SystemFraction, Mode=OneWay}" Maximum="1" Height="13" Background="#15202B" Foreground="#536579"/><TextBlock Text="{Binding MemoryText}" FontSize="10" Foreground="#AAB8C7" Margin="0,4,0,8"/>
        <TextBlock Text="AUTO VISUAL" Style="{StaticResource Label}"/><Button Command="{Binding JumpAutoCommand}" Padding="0" BorderThickness="0" ToolTip="Jump to the automatic visual candidate"><Grid Height="92" Background="#0B1118"><TextBlock Text="NO CANDIDATE" Foreground="#68798B" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding AutoThumbnail}" Stretch="Uniform"/></Grid></Button>
        <TextBlock Text="{Binding ConfidenceText}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,9"/><Button Content="MANUAL CLAP  ·  SPACE" Command="{Binding ManualClapCommand}" Background="#126B61" FontWeight="SemiBold"/>
        <TextBlock Text="←/→ step   Enter visual   A audio   R live   F5 reconnect" Foreground="#788B9E" FontSize="10" Margin="0,3,0,6"/><Button Content="☕  Buy me a coffee" Command="{Binding CoffeeCommand}" Opacity="0.48" FontSize="11" ToolTip="Buy me a coffee (link not configured)"/>
      </StackPanel></ScrollViewer>
    </Border>
    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,10" Padding="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#05080B" CornerRadius="8,8,0,0" ClipToBounds="True"><Grid><Image Source="{Binding VideoImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><Border Background="#B20B1118" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="9,5" CornerRadius="3"><StackPanel><TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="#5BD1BF"/><TextBlock Text="{Binding FormatText}" FontSize="11" Foreground="#B8C5D2"/></StackPanel></Border><TextBlock Text="{Binding ReviewPosition}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Background="#B20B1118" Padding="8,4" FontFamily="Consolas"/></Grid></Border><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="8"><Button Content="⏮  Previous" Command="{Binding StepPreviousCommand}"/><Button Content="Mark Visual  ⏎" Command="{Binding MarkVisualCommand}" Background="#314F70"/><Button Content="Next  ⏭" Command="{Binding StepNextCommand}"/><Button Content="Resume Live  R" Command="{Binding ResumeLiveCommand}"/></StackPanel></Grid>
    </Border>
    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
      <TextBlock Text="CURRENT RESULT" Style="{StaticResource Label}"/><TextBlock Text="{Binding ResultText}" FontSize="25" FontWeight="Bold" LineHeight="29" Margin="0,4,0,8"/><TextBlock Text="{Binding SyncValue, StringFormat={}{0:+0.0;-0.0;0.0} ms}" FontSize="34" FontFamily="Consolas" Foreground="#F5F8FB"/><Separator Background="#344A60" Margin="0,10"/>
      <TextBlock Text="VISUAL ANALYSIS" Style="{StaticResource Label}"/><TextBlock Text="{Binding ConfidenceText}"/><TextBlock Text="TIMING QUALITY" Style="{StaticResource Label}"/><TextBlock Text="{Binding TimingText}" Foreground="#F1C75B"/><TextBlock Text="SESSION HISTORY" Style="{StaticResource Label}" Margin="0,18,0,7"/>
      <ItemsControl ItemsSource="{Binding RecentResults}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#182431" CornerRadius="5" Padding="9" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="#8093A6" FontSize="10"/><TextBlock Text="{Binding Result.Wording}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Confidence, StringFormat=Auto confidence: {0:P0}}" Foreground="#8FA2B5" FontSize="10"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Session only · no media or results are saved" Foreground="#667A8E" FontSize="10" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <controls:WaveformView x:Name="Waveform" Samples="{Binding Waveform}" HalfWindowMs="{Binding HalfWindow}" AudioMarkerMs="{Binding AudioMarkerMs}" AutoVisualMs="{Binding AutoVisualMs}" VisualMarkerMs="{Binding VisualMarkerMs}" PlayheadMs="{Binding PlayheadMs}" AudioPointSelected="Waveform_AudioPointSelected"/>
      <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:SyncBar Grid.Column="0" Grid.ColumnSpan="3" Value="{Binding SyncValue}" Height="50" Margin="10,0"/><Border Grid.Column="1" Background="#EA121C27" CornerRadius="5" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding ResultText}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="15"/></Border></Grid>
    </Grid></Border>
  </Grid>
</Window>
