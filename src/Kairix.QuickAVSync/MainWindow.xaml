<Window x:Class="Kairix.QuickAVSync.MainWindow" Icon="Assets/Kairix.QuickAVSync.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kairix.QuickAVSync.Controls"
        Title="Kairix Quick A/V Sync" Width="1440" Height="850" MinWidth="1120" MinHeight="680" WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" Closing="Window_Closing">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="250"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SettingsColumnWidth}"/><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="7" Margin="0,0,10,10" AutomationProperties.AutomationId="SettingsPanel">
      <Grid>
        <Button Content="▶" Command="{Binding ToggleSettingsCommand}" Visibility="{Binding IsSettingsPanelExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}" ToolTip="Open settings" AutomationProperties.AutomationId="OpenSettingsRailButton"/>
        <Grid Visibility="{Binding IsSettingsPanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource PanelBackgroundBrush}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="2,0,0,7"><Button DockPanel.Dock="Right" Content="‹" Command="{Binding ToggleSettingsCommand}" Width="28" Height="26" Padding="0" Margin="4,0,0,0" ToolTip="Collapse settings" AutomationProperties.AutomationId="ToggleSettingsButton"/><TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/></DockPanel>
          <TabControl Grid.Row="1" SelectedIndex="0" Style="{StaticResource SettingsTabControlStyle}" ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}" AutomationProperties.AutomationId="SettingsTabs">
            <TabItem Header="◎  Detection" AutomationProperties.AutomationId="DetectionTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
              <TextBlock Text="DETECTION" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
              <CheckBox Content="Automatic detection" IsChecked="{Binding AutoDetect}" Margin="0,3,0,9" AutomationProperties.AutomationId="AutomaticDetectionToggle" ToolTip="Allow automatic detection to create review events."/>
              <CheckBox Content="Audio trigger" IsChecked="{Binding AutoSpike}" Margin="0,3,0,9" AutomationProperties.AutomationId="AudioTriggerToggle" ToolTip="Detect an audio transient and open an automatic review event."/>
              <CheckBox Content="Visual clap match" IsChecked="{Binding AutoVisual}" Margin="0,3,0,9" AutomationProperties.AutomationId="VisualClapMatchToggle" ToolTip="Find the visual hand/contact event inside the review."/>
              <TextBlock Text="VISUAL DETECTOR" Style="{StaticResource SectionLabelStyle}"/>
              <TextBlock Text="Visual detector" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding VisualDetectors}" SelectedItem="{Binding SelectedVisualDetector}" AutomationProperties.AutomationId="VisualDetectorSelector" Margin="0,0,0,7"/>
              <TextBlock Text="Detection resolution" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding DetectionResolutions}" SelectedItem="{Binding SelectedDetectionResolution}" AutomationProperties.AutomationId="DetectionResolutionSelector" ToolTip="Analysis image size. Larger values retain finer detail but use more memory and CPU."/>
              <TextBlock Text="Visual sensitivity" Style="{StaticResource FieldLabelStyle}" Margin="0,9,0,2"/>
              <Grid ToolTip="Higher values accept weaker correctly shaped cues; each detector retains its non-cue rejection rules."><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding VisualSensitivity}" AutomationProperties.AutomationId="VisualSensitivitySlider"/><controls:BoundedIntegerBox Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VisualSensitivity}" Style="{StaticResource {x:Type TextBox}}" HorizontalContentAlignment="Right" Padding="4,2" Margin="5,0,0,0" FontFamily="Consolas" FontWeight="SemiBold" AutomationProperties.AutomationId="VisualSensitivityInput" AutomationProperties.Name="Visual sensitivity, 0 to 100"/></Grid>
              <TextBlock Text="AUDIO DETECTOR" Style="{StaticResource SectionLabelStyle}"/>
              <TextBlock Text="Transient sensitivity" Style="{StaticResource FieldLabelStyle}"/>
              <Grid ToolTip="Higher values detect quieter audio onsets. Lower values require a stronger peak above the adaptive noise floor."><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding AudioSensitivity}" AutomationProperties.AutomationId="AudioSensitivitySlider"/><controls:BoundedIntegerBox Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AudioSensitivity}" Style="{StaticResource {x:Type TextBox}}" HorizontalContentAlignment="Right" Padding="4,2" Margin="5,0,0,0" FontFamily="Consolas" FontWeight="SemiBold" AutomationProperties.AutomationId="AudioSensitivityInput" AutomationProperties.Name="Audio sensitivity, 0 to 100"/></Grid>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="◐  Appearance" AutomationProperties.AutomationId="AppearanceTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
              <TextBlock Text="APPEARANCE" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
              <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.AutomationId="ThemeSelector"/>
              <TextBlock Text="Waveform style" Style="{StaticResource FieldLabelStyle}" Margin="0,9,0,2"/><ComboBox ItemsSource="{Binding AudioDisplayStyles}" SelectedItem="{Binding SelectedAudioDisplayStyle}" AutomationProperties.AutomationId="AudioDisplayStyleSelector" ToolTip="Display only."/>
              <TextBlock Text="Amplitude" Style="{StaticResource FieldLabelStyle}" Margin="0,9,0,2"/><ComboBox ItemsSource="{Binding AudioDisplayAmplitudes}" SelectedItem="{Binding SelectedAudioDisplayAmplitude}" AutomationProperties.AutomationId="AudioDisplayAmplitudeSelector" ToolTip="Display only."/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="↔  Review" AutomationProperties.AutomationId="ReviewTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
              <TextBlock Text="REVIEW" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
              <TextBlock Text="Review image resolution" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding ReviewResolutions}" SelectedItem="{Binding SelectedReviewResolution}" AutomationProperties.AutomationId="ReviewResolutionSelector"/>
              <TextBlock Text="Rolling buffer (s)" Style="{StaticResource FieldLabelStyle}" Margin="0,9,0,2"/><TextBox Text="{Binding RollingBufferSeconds, UpdateSourceTrigger=LostFocus}"/>
              <TextBlock Text="Work window (±ms)" Style="{StaticResource FieldLabelStyle}" Margin="0,9,0,2"/><TextBox Text="{Binding WorkWindowMilliseconds, UpdateSourceTrigger=LostFocus}"/>
              <TextBlock Text="Session history depth" Style="{StaticResource FieldLabelStyle}" Margin="0,9,0,2"/><ComboBox ItemsSource="{Binding SessionHistoryDepths}" SelectedItem="{Binding SessionHistoryDepth}" AutomationProperties.AutomationId="SessionHistoryDepthSelector" AutomationProperties.Name="Session history depth: retain 3, 5, or 10 events" ToolTip="Choose how many recent automatic events remain available for in-memory review (3, 5, or 10)." MinWidth="104" HorizontalAlignment="Left"/>
              <TextBlock Text="{Binding HistoryMemoryText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="▣  Capture" AutomationProperties.AutomationId="CaptureTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
              <TextBlock Text="CAPTURE" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
              <CheckBox Content="Show all capture modes" IsChecked="{Binding ShowAllCaptureModes}" AutomationProperties.AutomationId="ShowAllCaptureModesToggle" ToolTip="Show every native mode reported by the selected capture driver. The normal list keeps Auto and recommended modes." Margin="0,3,0,9"/>
              <TextBlock Text="Capture mode and interpretation are separate: the mode is the exact driver request; interpretation controls review timing and optional field reconstruction." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,8"/>
              <TextBlock Text="Video timing offset (ms)" Style="{StaticResource FieldLabelStyle}" Margin="0,9,0,2"/><TextBox Text="{Binding VideoTimingOffsetMilliseconds, UpdateSourceTrigger=LostFocus, StringFormat={}{0:+0.000;-0.000;0.000}}" AutomationProperties.AutomationId="VideoTimingOffsetTextBox"/>
              <TextBlock Text="{Binding VideoTimingOffsetModeText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,4,0,6"/><Button Content="Reset to automatic" Command="{Binding ResetVideoTimingOffsetCommand}" AutomationProperties.AutomationId="ResetVideoTimingOffsetButton"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="⌨  Shortcuts" AutomationProperties.AutomationId="ShortcutsTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
              <TextBlock Text="SHORTCUTS" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Open a manual clap review and place the audio reference at the latest captured audio." AutomationProperties.AutomationId="ShortcutRowSpace"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Space" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Manual Clap"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Commit the current video playhead as the visual event." AutomationProperties.AutomationId="ShortcutRowEnter"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Enter" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Mark Visual"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Step one video frame or reconstructed field earlier." AutomationProperties.AutomationId="ShortcutRowLeft"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Left" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Pre V"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Step one video frame or reconstructed field later." AutomationProperties.AutomationId="ShortcutRowRight"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Right" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Nxt V"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Move ten video positions earlier for coarse review navigation." AutomationProperties.AutomationId="ShortcutRowShiftLeft"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Shift+Left" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Coarse Pre V"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Move ten video positions later for coarse review navigation." AutomationProperties.AutomationId="ShortcutRowShiftRight"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Shift+Right" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Coarse Nxt V"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Move the audio mark 1.0 milliseconds earlier." AutomationProperties.AutomationId="ShortcutRowCtrlLeft"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Ctrl+Left" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Pre A · 1.0 ms"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Move the audio mark 1.0 milliseconds later." AutomationProperties.AutomationId="ShortcutRowCtrlRight"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Ctrl+Right" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Nxt A · 1.0 ms"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Move the audio mark directly to the current video playhead." AutomationProperties.AutomationId="ShortcutRowA"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="A" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Mark audio at playhead"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Toggle between ARMED and HOLD without stopping capture or rolling buffers." AutomationProperties.AutomationId="ShortcutRowH"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="H" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Arm / Hold"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Clear the displayed review and return the viewer to live capture." AutomationProperties.AutomationId="ShortcutRowR"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="R" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Live View"/></Grid></Border>
              <Border Style="{StaticResource ShortcutRowStyle}" ToolTip="Close and reopen the selected capture session using the current settings." AutomationProperties.AutomationId="ShortcutRowF5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="F5" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Reconnect"/></Grid></Border>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="ⓘ  About" AutomationProperties.AutomationId="AboutTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
              <TextBlock Text="ABOUT" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,4"/><TextBlock Text="Kairix Quick A/V Sync" FontWeight="SemiBold"/><TextBlock Text="{Binding BuildChannelText}"/><TextBlock Text="{Binding BuildText}" FontFamily="Consolas"/><TextBlock Text="{Binding BuildCommitText}" FontFamily="Consolas"/><TextBlock Text="{Binding VersionText, StringFormat=Assembly version {0}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"/>
              <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabelStyle}"/><controls:MemoryBar OtherUsedFraction="{Binding OtherSystemFraction}" ProcessFraction="{Binding AppFraction}" Height="13"/><TextBlock Text="{Binding MemoryText}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,7"/><TextBlock Text="{Binding BufferEstimateText}" FontFamily="Consolas" FontSize="10"/><TextBlock Text="{Binding BufferEstimateWarning}" FontSize="10" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,7"/>
              <TextBlock Text="RUNTIME HEALTH" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding RuntimeHealthText}" FontFamily="Consolas" FontSize="10"/><TextBlock Text="VIDEO TIMING" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding AboutTimingDiagnosticsText}" FontFamily="Consolas" FontSize="10"/><TextBlock Text="{Binding ContentWarningText}" Foreground="{DynamicResource WarningBrush}" FontSize="10" Margin="0,5,0,0"/>
              <TextBlock Text="FIELD RECONSTRUCTION" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding FieldReconstructionAboutText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"/>
              <TextBlock Text="LAST DETECTED EVENT" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding LastEventDiagnosticsText}" FontFamily="Consolas" FontSize="9"/>
              <WrapPanel Margin="0,12,0,0" AutomationProperties.Name="Project links">
                <Button Content="Buy me a coffee" Command="{Binding CoffeeCommand}" AutomationProperties.AutomationId="BuyMeACoffeeLink" Opacity="0.82" FontSize="10" Padding="7,4" Margin="0,0,6,6"/>
                <Button Content="GitHub" Command="{Binding GitHubCommand}" AutomationProperties.AutomationId="GitHubLink" Opacity="0.82" FontSize="10" Padding="7,4" Margin="0,0,6,6"/>
                <Button Content="Project website" Command="{Binding ProjectWebsiteCommand}" AutomationProperties.AutomationId="ProjectWebsiteLink" Opacity="0.82" FontSize="10" Padding="7,4" Margin="0,0,6,6"/>
              </WrapPanel>
            </StackPanel></ScrollViewer></TabItem>
          </TabControl>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,10" AutomationProperties.AutomationId="OperationPanel"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="KAIRIX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Quick A/V Sync" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock Text="INPUT" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="Capture device" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutomationProperties.AutomationId="CaptureDeviceSelector" Margin="0,0,0,8"/>
      <TextBlock Text="Capture mode" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding CaptureModes}" SelectedItem="{Binding SelectedCaptureFormat}" AutomationProperties.AutomationId="CaptureModeSelector" ToolTip="Auto lets the driver choose. Any named mode is requested exactly." Margin="0,0,0,7"/>
      <TextBlock Text="Interpretation" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding InterpretationFormats}" SelectedItem="{Binding SelectedInterpretationFormat}" AutomationProperties.AutomationId="CaptureInterpretationSelector" ToolTip="How Kairix interprets the negotiated transport for review. This does not select the driver capture mode." Margin="0,0,0,7"/>
      <TextBlock Text="Driver capture" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding DriverCaptureText}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="10" Margin="1,0,0,5" TextWrapping="Wrap"/>
      <TextBlock Text="Observed delivery" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding ObservedDeliveryText}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="10" Margin="1,0,0,5"/>
      <TextBlock Text="Source cadence" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SourceCadenceText}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="10" Margin="1,0,0,8" TextWrapping="Wrap"/>
      <TextBlock Text="LIVE AUDIO" Style="{StaticResource SectionLabelStyle}"/><controls:LiveAudioMeter Height="22" LeftLevel="{Binding AudioLeftLevel}" RightLevel="{Binding AudioRightLevel}" ChannelCount="{Binding LiveAudioChannels}" AutomationProperties.AutomationId="LiveAudioMeter" AutomationProperties.Name="Live input audio peak meter"/>
      <TextBlock Text="{Binding LiveAudioFormatText}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="10" Margin="1,4,0,1"/><TextBlock Text="{Binding LiveAudioLevelText}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" Margin="1,0,0,7"/>
      <WrapPanel><Button Content="Refresh" Command="{Binding RefreshCommand}"/><Button Content="Reconnect" Command="{Binding ReconnectCommand}"/></WrapPanel>
      <ToggleButton Content="{Binding ArmStateText}" IsChecked="{Binding IsHold}" IsEnabled="{Binding IsArmEnabled}" Margin="0,10,0,7" FontSize="16" FontWeight="Bold" AutomationProperties.AutomationId="ArmHoldButton">
        <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="ToolTip" Value="Armed: an audio transient can create a new automatic review event."/><Setter Property="Background" Value="{DynamicResource PositiveBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="ToolTip" Value="Held: automatic events are paused. Capture and buffering continue."/><Setter Property="Background" Value="{DynamicResource WarningBrush}"/><Setter Property="Foreground" Value="#FF1B1300"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="Enable Automatic detection and Audio trigger in Settings → Detection."/></Trigger></Style.Triggers></Style></ToggleButton.Style>
      </ToggleButton>
      <TextBlock Text="AUTO CANDIDATE" Style="{StaticResource SectionLabelStyle}"/><Button Command="{Binding JumpAutoCommand}" Padding="0" ToolTip="Jump to the automatic visual candidate"><Grid Height="92" Background="{DynamicResource VideoBackgroundBrush}"><TextBlock Text="NO CANDIDATE" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding AutoThumbnail}" Stretch="Uniform"/></Grid></Button>
      <TextBlock Text="{Binding ConfidenceText}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,9"/><Button Content="MANUAL CLAP  ·  SPACE" Command="{Binding ManualClapCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
    </StackPanel></ScrollViewer></Border>

    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,10" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource VideoBackgroundBrush}" CornerRadius="8,8,0,0" ClipToBounds="True"><Grid><Image Source="{Binding VideoImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{Binding ReviewPosition}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Background="{DynamicResource OverlayBackgroundBrush}" Padding="8,4" FontFamily="Consolas"/></Grid></Border>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="8"><Button Content="Pre A" Command="{Binding StepAudioPreviousCommand}" ToolTip="Move the audio mark 1.0 ms earlier."/><Button Content="Pre V" Command="{Binding StepPreviousCommand}" ToolTip="Step one visual frame/field earlier."/><Button Content="Mark Visual" Command="{Binding MarkVisualCommand}" IsEnabled="{Binding IsInReview}" ToolTip="Use the currently selected video frame/field as the visual event."/><Button Content="Nxt V" Command="{Binding StepNextCommand}" ToolTip="Step one visual frame/field later."/><Button Content="Nxt A" Command="{Binding StepAudioNextCommand}" ToolTip="Move the audio mark 1.0 ms later."/><Button Content="Live View" Command="{Binding ResumeLiveCommand}" ToolTip="Clear the displayed review and show live capture. Arm / Hold is unchanged."/></StackPanel>
    </Grid></Border>

    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0,0,0,10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="CURRENT RESULT" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding ResultModeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,2"/><TextBlock Text="{Binding ResultText}" FontSize="25" FontWeight="Bold" LineHeight="29" Margin="0,2,0,8"/><TextBlock Text="{Binding SyncValue, StringFormat={}{0:+0.0;-0.0;0.0} ms}" FontSize="34" FontFamily="Consolas"/><Separator Background="{DynamicResource BorderBrush}" Margin="0,10"/>
      <TextBlock Text="VISUAL CONFIDENCE" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding ConfidenceText}" FontSize="24" FontFamily="Consolas"/>
      <TextBlock Text="SESSION HISTORY" Style="{StaticResource SectionLabelStyle}" Margin="0,18,0,2"/><TextBlock Text="Select an event to reopen its retained review" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,7"/><ItemsControl ItemsSource="{Binding RecentResults}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="HistoryResultButton" AutomationProperties.Name="Open retained event review" Padding="9" Margin="0,0,0,6" HorizontalContentAlignment="Stretch" ToolTip="Hold automatic detection and review this retained event"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/><TextBlock Text="{Binding Result.Wording}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Confidence, StringFormat=Confidence {0:P0}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="OPEN  ›" Foreground="{DynamicResource ControlTextBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></Border>

    <Border Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <controls:WaveformView x:Name="Waveform" Samples="{Binding Waveform}" DisplayStyle="{Binding SelectedAudioDisplayStyle}" DisplayAmplitude="{Binding SelectedAudioDisplayAmplitude}" FrameTicksMs="{Binding ReviewFrameTicks}" HalfWindowMs="{Binding HalfWindow}" AudioMarkerMs="{Binding AudioMarkerMs}" AutoVisualMs="{Binding AutoVisualMs}" VisualMarkerMs="{Binding VisualMarkerMs}" PlayheadMs="{Binding PlayheadMs}" PlayheadSelected="Waveform_PlayheadSelected" AudioPointPreviewed="Waveform_AudioPointPreviewed" AudioPointCommitted="Waveform_AudioPointCommitted" FrameStepRequested="Waveform_FrameStepRequested"/>
      <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:SyncBar Grid.Column="0" Grid.ColumnSpan="3" Value="{Binding SyncValue}" Height="50" Margin="10,0"/><Border Grid.Column="1" Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding ResultSummaryText}" TextAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"/></Border></Grid>
    </Grid></Border>
  </Grid>
</Window>
