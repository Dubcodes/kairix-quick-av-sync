<Window x:Class="Kairix.QuickAVSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kairix.QuickAVSync.Controls"
        Title="Kairix Quick A/V Sync" Width="1440" Height="850" MinWidth="1000" MinHeight="680" WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" Closing="Window_Closing">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="250"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SettingsColumnWidth}"/><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="7" Margin="0,0,10,10" AutomationProperties.AutomationId="SettingsPanel">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Button Content="{Binding SettingsPanelToggleText}" Command="{Binding ToggleSettingsCommand}" Padding="4,7" Margin="0,0,0,6" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="ToggleSettingsButton"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsPanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="SETTINGS" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.AutomationId="ThemeSelector"/>

            <TextBlock Text="DETECTION" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="Detection resolution" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox ItemsSource="{Binding DetectionResolutions}" SelectedItem="{Binding SelectedDetectionResolution}" AutomationProperties.AutomationId="DetectionResolutionSelector"/>
            <TextBlock Text="Visual sensitivity" Style="{StaticResource FieldLabelStyle}" Margin="0,7,0,2"/>
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding VisualSensitivity}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding VisualSensitivity}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Grid>

            <TextBlock Text="REVIEW" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="Review image resolution" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox ItemsSource="{Binding ReviewResolutions}" SelectedItem="{Binding SelectedReviewResolution}" AutomationProperties.AutomationId="ReviewResolutionSelector"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Rolling buffer (s)" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding RollingBufferSeconds, UpdateSourceTrigger=LostFocus}"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Work window (±ms)" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding WorkWindowMilliseconds, UpdateSourceTrigger=LostFocus}"/></StackPanel>
            </Grid>

            <TextBlock Text="CAPTURE / ADVANCED" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="Pixel format" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox ItemsSource="{Binding PixelFormats}" SelectedItem="{Binding SelectedPixelFormat}" ToolTip="The exact native pixel format requested from Media Foundation."/>

            <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="RAM" Style="{StaticResource FieldLabelStyle}"/>
            <controls:MemoryBar OtherUsedFraction="{Binding OtherSystemFraction}" ProcessFraction="{Binding AppFraction}" Height="13"/>
            <TextBlock Text="{Binding MemoryText}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,7"/>
            <TextBlock Text="VIDEO BUFFER ESTIMATE" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding BufferEstimateText}" FontFamily="Consolas" FontSize="10"/>
            <TextBlock Text="{Binding BufferEstimateWarning}" FontSize="10" Margin="0,4,0,7"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsBufferEstimateHigh}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsBufferEstimateVeryHigh}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>

            <TextBlock Text="SUPPORT" Style="{StaticResource SectionLabelStyle}"/><Button Content="☕  Buy me a coffee" Command="{Binding CoffeeCommand}" Opacity="0.72" FontSize="11" ToolTip="Buy me a coffee"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,10" AutomationProperties.AutomationId="OperationPanel">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="KAIRIX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Quick A/V Sync" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="CAPTURE DEVICE" Style="{StaticResource SectionLabelStyle}"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Margin="0,0,0,8"/>
        <TextBlock Text="DETECTED CAPTURE" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding DetectedCaptureText}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="11" Margin="1,0,0,8"/>
        <TextBlock Text="INPUT INTERPRETATION" Style="{StaticResource SectionLabelStyle}"/>
        <TextBlock Text="Resolution" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" Margin="0,0,0,7"/>
        <TextBlock Text="Format" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding InterpretationFormats}" SelectedItem="{Binding SelectedInterpretationFormat}" Margin="0,0,0,6"/>
        <CheckBox Content="Reconstruct interlaced fields" IsChecked="{Binding ReconstructInterlacedFields}" FontSize="11" Margin="1,0,0,3" ToolTip="Use when a progressive capture frame contains two woven fields from an interlaced source."/>
        <TextBlock Text="{Binding FieldReconstructionHelpText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="1,0,0,7"/>
        <WrapPanel><Button Content="Refresh Devices" Command="{Binding RefreshCommand}"/><Button Content="Reconnect" Command="{Binding ReconnectCommand}"/></WrapPanel>

        <TextBlock Text="OPERATION" Style="{StaticResource SectionLabelStyle}"/>
        <ToggleButton IsChecked="{Binding AutoDetect}" AutomationProperties.AutomationId="AutoDetectToggle"><ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Content" Value="AUTO DETECT · OFF"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="AUTO DETECT · ON"/></Trigger></Style.Triggers></Style></ToggleButton.Style></ToggleButton>
        <ToggleButton IsChecked="{Binding AutoSpike}"><ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Content" Value="AUTO SPIKE · OFF"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="AUTO SPIKE · ON"/></Trigger></Style.Triggers></Style></ToggleButton.Style></ToggleButton>
        <ToggleButton IsChecked="{Binding AutoVisual}"><ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Content" Value="AUTO VISUAL · OFF"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="AUTO VISUAL · ON"/></Trigger></Style.Triggers></Style></ToggleButton.Style></ToggleButton>
        <ToggleButton IsChecked="{Binding IsHold}" ToolTip="Toggle automatic-event hold. Capture and buffering continue."><ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Content" Value="HOLD AUTO DETECT · OFF"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="HOLD AUTO DETECT · ON"/></Trigger></Style.Triggers></Style></ToggleButton.Style></ToggleButton>

        <TextBlock Text="AUTO CANDIDATE" Style="{StaticResource SectionLabelStyle}"/><Button Command="{Binding JumpAutoCommand}" Padding="0" ToolTip="Jump to the automatic visual candidate"><Grid Height="92" Background="{DynamicResource VideoBackgroundBrush}"><TextBlock Text="NO CANDIDATE" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding AutoThumbnail}" Stretch="Uniform"/></Grid></Button>
        <TextBlock Text="{Binding ConfidenceText}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,9"/><Button Content="MANUAL CLAP  ·  SPACE" Command="{Binding ManualClapCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
        <TextBlock Text="H toggle · ←/→ step · Enter visual · A audio · R live · F5 reconnect" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,3,0,6"/>
      </StackPanel></ScrollViewer>
    </Border>

    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,10" Padding="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource VideoBackgroundBrush}" CornerRadius="8,8,0,0" ClipToBounds="True"><Grid><Image Source="{Binding VideoImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><Border Background="{DynamicResource OverlayBackgroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="9,5" CornerRadius="3"><StackPanel><TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding DetectedCaptureText, StringFormat=Detected: {0}}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding InterpretationText, StringFormat=Interpretation: {0}}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding ContentWarningText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" MaxWidth="430"/></StackPanel></Border><TextBlock Text="{Binding ReviewPosition}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Background="{DynamicResource OverlayBackgroundBrush}" Padding="8,4" FontFamily="Consolas"/></Grid></Border><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="8"><Button Content="⏮  Previous" Command="{Binding StepPreviousCommand}"/><Button Content="Mark Visual  ⏎" Command="{Binding MarkVisualCommand}"/><Button Content="Next  ⏭" Command="{Binding StepNextCommand}"/><Button Content="Resume Live  R" Command="{Binding ResumeLiveCommand}"/></StackPanel></Grid>
    </Border>

    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
      <TextBlock Text="CURRENT RESULT" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding ResultModeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,2"/><TextBlock Text="{Binding ResultText}" FontSize="25" FontWeight="Bold" LineHeight="29" Margin="0,2,0,8"/><TextBlock Text="{Binding SyncValue, StringFormat={}{0:+0.0;-0.0;0.0} ms}" FontSize="34" FontFamily="Consolas"/><Separator Background="{DynamicResource BorderBrush}" Margin="0,10"/>
      <TextBlock Text="VISUAL ANALYSIS" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding ConfidenceText}"/><TextBlock Text="TIMING QUALITY" Style="{StaticResource SectionLabelStyle}"/><TextBlock Text="{Binding TimingText}" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="{Binding TimelineIntegrityText}" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding ReviewTimingText}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding CaptureTransportText}" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="{Binding TimestampPhaseText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="{Binding VisualReviewResolutionText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="SESSION HISTORY" Style="{StaticResource SectionLabelStyle}" Margin="0,18,0,7"/><ItemsControl ItemsSource="{Binding RecentResults}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelSecondaryBrush}" CornerRadius="5" Padding="9" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/><TextBlock Text="{Binding Result.Wording}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Confidence, StringFormat=Auto confidence: {0:P0}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Session only · no media or results are saved" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,8,0,0"/>
    </StackPanel></Border>

    <Border Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <controls:WaveformView x:Name="Waveform" Samples="{Binding Waveform}" FrameTicksMs="{Binding ReviewFrameTicks}" HalfWindowMs="{Binding HalfWindow}" AudioMarkerMs="{Binding AudioMarkerMs}" AutoVisualMs="{Binding AutoVisualMs}" VisualMarkerMs="{Binding VisualMarkerMs}" PlayheadMs="{Binding PlayheadMs}" PlayheadSelected="Waveform_PlayheadSelected" AudioPointPreviewed="Waveform_AudioPointPreviewed" AudioPointCommitted="Waveform_AudioPointCommitted" FrameStepRequested="Waveform_FrameStepRequested"/>
      <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:SyncBar Grid.Column="0" Grid.ColumnSpan="3" Value="{Binding SyncValue}" Height="50" Margin="10,0"/><Border Grid.Column="1" Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding ResultSummaryText}" TextAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"/></Border></Grid>
    </Grid></Border>
  </Grid>
</Window>
